#include <iostream>
#include <cmath> // Required for abs()

using namespace std;

int main() {
    int num, originalNum;
    long long product = 1;

    cout << "Enter an integer: ";
    cin >> num;

    // Save the original number for the final output display
    originalNum = num;

    // Handle negative numbers by converting to absolute value
    num = abs(num);

    // Handle the specific case where the input is 0
    if (num == 0) {
        product = 0;
    } else {
        while (num > 0) {
            int digit = num % 10;  // Extract the last digit
            product *= digit;      // Multiply the digit to the product
            num /= 10;             // Remove the last digit
        }
    }

    cout << "The product of the digits of " << originalNum << " is: " << product << endl;

    return 0;
}
