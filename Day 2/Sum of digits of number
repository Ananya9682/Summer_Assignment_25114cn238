#include <iostream>
#include <cmath> // Required for abs()

using namespace std;

int main() {
    long long number;
    long long originalNumber;
    long long sum = 0;

    //Get input from the user
    cout << "Enter an integer: ";
    cin >> number;

    // Store original number for final output and handle negative numbers
    originalNumber = number;
    number = abs(number);

    // Loop to extract and add each digit
    while (number > 0) {
        sum += number % 10; // Extract the last digit and add to sum
        number /= 10;       // Remove the last digit from the number
    }

    // Display the result
    cout << "The sum of the digits of " << originalNumber << " is: " << sum << endl;

    return 0;
}
