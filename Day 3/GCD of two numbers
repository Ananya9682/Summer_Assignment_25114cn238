#include <iostream>
using namespace std;

// Function to calculate GCD using the Euclidean algorithm
int findGCD(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int main() {
    int num1, num2;
    
    cout << "Enter two integers: ";
    cin >> num1 >> num2;
    
    // Call function and display the result
    cout << "GCD of " << num1 << " and " << num2 << " is: " << findGCD(num1, num2) << endl;
    
    return 0;
}
