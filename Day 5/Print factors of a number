#include <iostream>
using namespace std;

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;

    cout << "Factors of " << num << " are:\n";

    for (int i = 1; i * i <= num; i++) {
        if (num % i == 0) {
            cout << i << " ";

            if (i != num / i) {
                cout << num / i << " ";
            }
        }
    }

    return 0;
}