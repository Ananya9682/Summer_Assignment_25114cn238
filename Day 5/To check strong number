#include <iostream>
using namespace std;

bool isStrongNumber(int num) {
    int fact[10] = {1, 1, 2, 6, 24, 120, 720, 5040, 40320, 362880};

    int original = num;
    int sum = 0;

    while (num > 0) {
        sum += fact[num % 10];
        num /= 10;
    }

    return sum == original;
}

int main() {
    int number;
    cin >> number;
    // get the output here
    if (isStrongNumber(number))
        cout << "Strong Number";
    else
        cout << "Not a Strong Number";

    return 0;
}