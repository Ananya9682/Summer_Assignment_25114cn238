#include <iostream>
using namespace std;

struct Student {
    int rollNo;
    char name[50];
    float marks;
};

int main() {
    Student s[100];
    int n;

    cout << "Enter number of students: ";
    cin >> n;

    // Input student records
    for (int i = 0; i < n; i++) {
        cout << "\nStudent " << i + 1 << endl;

        cout << "Enter Roll Number: ";
        cin >> s[i].rollNo;

        cin.ignore();

        cout << "Enter Name: ";
        cin.getline(s[i].name, 50);

        cout << "Enter Marks: ";
        cin >> s[i].marks;
    }

    // Display student records
    cout << "\n===== STUDENT RECORDS =====\n";

    for (int i = 0; i < n; i++) {
        cout << "\nRoll Number: " << s[i].rollNo;
        cout << "\nName: " << s[i].name;
        cout << "\nMarks: " << s[i].marks << endl;
    }

    return 0;
}