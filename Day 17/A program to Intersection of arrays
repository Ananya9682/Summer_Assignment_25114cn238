#include <iostream>
using namespace std;

int main() {
    int arr1[100], arr2[100], intersection[100];
    int n1, n2, size = 0;

    cout << "Enter the number of elements in first array: ";
    cin >> n1;

    cout << "Enter elements of first array: ";
    for (int i = 0; i < n1; i++) {
        cin >> arr1[i];
    }

    cout << "Enter the number of elements in second array: ";
    cin >> n2;

    cout << "Enter elements of second array: ";
    for (int i = 0; i < n2; i++) {
        cin >> arr2[i];
    }

    // Find common elements
    for (int i = 0; i < n1; i++) {
        bool found = false;

        for (int j = 0; j < n2; j++) {
            if (arr1[i] == arr2[j]) {
                found = true;
                break;
            }
        }

        // Check if the element is already added
        bool alreadyAdded = false;
        for (int k = 0; k < size; k++) {
            if (intersection[k] == arr1[i]) {
                alreadyAdded = true;
                break;
            }
        }

        if (found && !alreadyAdded) {
            intersection[size++] = arr1[i];
        }
    }

    cout << "Intersection of arrays: ";
    for (int i = 0; i < size; i++) {
        cout << intersection[i] << " ";
    }

    return 0;
}