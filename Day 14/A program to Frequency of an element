#include <iostream>
using namespace std;

int main() {
    int arr[100], n, key, count = 0;

    cout << "Enter the number of elements: ";
    cin >> n;

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter the element to find frequency: ";
    cin >> key;

    // Count frequency
    for (int i = 0; i < n; i++) {
        if (arr[i] == key) {
            count++;
        }
    }

    cout << "Frequency of " << key << " = " << count;

    return 0;
}