#include <iostream>
using namespace std;

int main() {
    int terms;
    // Using long long to handle larger Fibonacci numbers without early overflow
    long long first = 0, second = 1, nextTerm = 0;

    cout << "Enter the number of terms: ";
    cin >> terms;

    cout << "Fibonacci Series: ";

    for (int i = 1; i <= terms; ++i) {
        // Handle and print the first term
        if (i == 1) {
            cout << first;
            if (terms > i) cout << ", ";
            continue;
        }
        // Handle and print the second term
        if (i == 2) {
            cout << second;
            if (terms > i) cout << ", ";
            continue;
        }
        
        // Calculate subsequent terms by summing the previous two
        nextTerm = first + second;
        first = second;
        second = nextTerm;

        cout << nextTerm;
        if (i < terms) cout << ", ";
    }

    cout << endl;
    return 0;
}
