#include <iostream>
#include <cmath>

using namespace std;

// Function to check if a number is an Armstrong number
bool isArmstrong(int num) {
    int originalNum = num;
    int temp = num;
    int digits = 0;
    int sum = 0;

    // Step 1: Count the total number of digits
    while (temp > 0) {
        temp /= 10;
        digits++;
    }

    temp = num; // Reset temp to the original number

    // Step 2: Compute the sum of digits raised to the power of 'digits'
    while (temp > 0) {
        int remainder = temp % 10;
        
        // round() helps avoid potential floating-point inaccuracies with pow()
        sum += round(pow(remainder, digits)); 
        
        temp /= 10;
    }

    // Step 3: Compare sum with the original number
    return (sum == originalNum);
}

int main() {
    int number;

    cout << "Enter an integer to check: ";
    cin >> number;

    // Call the function and print the appropriate message
    if (isArmstrong(number)) {
        cout << number << " is an Armstrong number." << endl;
    } else {
        cout << number << " is not an Armstrong number." << endl;
    }

    return 0;
}
