#include <iostream>
#include <string>
using namespace std;

int main() {
    int n;

    cout << "Enter number of books: ";
    cin >> n;
    cin.ignore();

    int bookId[100];
    string title[100];
    string author[100];

    // Input book details
    for (int i = 0; i < n; i++) {
        cout << "\nBook " << i + 1 << endl;

        cout << "Enter Book ID: ";
        cin >> bookId[i];
        cin.ignore();

        cout << "Enter Book Title: ";
        getline(cin, title[i]);

        cout << "Enter Author Name: ";
        getline(cin, author[i]);
    }

    // Display book records
    cout << "\n===== MINI LIBRARY SYSTEM =====\n";

    for (int i = 0; i < n; i++) {
        cout << "\nBook ID     : " << bookId[i] << endl;
        cout << "Book Title  : " << title[i] << endl;
        cout << "Author Name : " << author[i] << endl;
    }

    return 0;
}