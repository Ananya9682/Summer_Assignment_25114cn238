#include <iostream>
#include <string>
using namespace std;

int main() {
    int n;

    cout << "Enter number of students: ";
    cin >> n;
    cin.ignore();

    int rollNo[100];
    string name[100];
    float marks[100];

    // Input student records
    for (int i = 0; i < n; i++) {
        cout << "\nStudent " << i + 1 << endl;

        cout << "Enter Roll Number: ";
        cin >> rollNo[i];
        cin.ignore();

        cout << "Enter Name: ";
        getline(cin, name[i]);

        cout << "Enter Marks: ";
        cin >> marks[i];
        cin.ignore();
    }

    // Display student records
    cout << "\n===== STUDENT RECORD SYSTEM =====\n";

    for (int i = 0; i < n; i++) {
        cout << "\nRoll Number : " << rollNo[i] << endl;
        cout << "Name        : " << name[i] << endl;
        cout << "Marks       : " << marks[i] << endl;
    }

    return 0;
}