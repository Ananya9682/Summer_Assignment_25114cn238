#include <iostream>
using namespace std;

struct Contact {
    string name;
    string phone;
};

int main() {
    Contact contacts[100];
    int n;

    cout << "Enter number of contacts: ";
    cin >> n;
    cin.ignore();

    // Input contacts
    for (int i = 0; i < n; i++) {
        cout << "\nContact " << i + 1 << endl;

        cout << "Enter Name: ";
        getline(cin, contacts[i].name);

        cout << "Enter Phone Number: ";
        getline(cin, contacts[i].phone);
    }

    // Display contacts
    cout << "\n===== CONTACT LIST =====\n";

    for (int i = 0; i < n; i++) {
        cout << "\nName : " << contacts[i].name << endl;
        cout << "Phone: " << contacts[i].phone << endl;
    }

    return 0;
}