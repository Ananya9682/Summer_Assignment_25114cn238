#include <iostream>
using namespace std;

struct Book {
    int bookId;
    string title;
    string author;
};

int main() {
    Book books[100];
    int n;

    cout << "Enter number of books: ";
    cin >> n;
    cin.ignore();

    // Input book details
    for (int i = 0; i < n; i++) {
        cout << "\nBook " << i + 1 << endl;

        cout << "Enter Book ID: ";
        cin >> books[i].bookId;
        cin.ignore();

        cout << "Enter Book Title: ";
        getline(cin, books[i].title);

        cout << "Enter Author Name: ";
        getline(cin, books[i].author);
    }

    // Display book records
    cout << "\n===== LIBRARY BOOK RECORDS =====\n";

    for (int i = 0; i < n; i++) {
        cout << "\nBook ID : " << books[i].bookId;
        cout << "\nTitle   : " << books[i].title;
        cout << "\nAuthor  : " << books[i].author << endl;
    }

    return 0;
}