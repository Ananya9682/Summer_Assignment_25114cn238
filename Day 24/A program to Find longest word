#include <iostream>
using namespace std;

int main() {
    char str[200];
    char longest[100];
    int maxLen = 0, currentLen = 0;
    int start = 0, longestStart = 0;

    cout << "Enter a sentence: ";
    cin.getline(str, 200);

    for (int i = 0; ; i++) {
        if (str[i] != ' ' && str[i] != '\0') {
            currentLen++;
        } else {
            if (currentLen > maxLen) {
                maxLen = currentLen;
                longestStart = start;
            }

            currentLen = 0;
            start = i + 1;
        }

        if (str[i] == '\0')
            break;
    }

    // Copy the longest word
    for (int i = 0; i < maxLen; i++) {
        longest[i] = str[longestStart + i];
    }
    longest[maxLen] = '\0';

    cout << "Longest word: " << longest << endl;
    cout << "Length: " << maxLen << endl;

    return 0;
}