#include <iostream>
using namespace std;

int main() {
    char str[100];
    bool visited[256] = {false};

    cout << "Enter a string: ";
    cin.getline(str, 100);

    cout << "String after removing duplicate characters: ";

    for (int i = 0; str[i] != '\0'; i++) {
        if (!visited[(unsigned char)str[i]]) {
            cout << str[i];
            visited[(unsigned char)str[i]] = true;
        }
    }

    return 0;
}