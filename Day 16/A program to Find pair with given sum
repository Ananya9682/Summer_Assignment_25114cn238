#include <iostream>
using namespace std;

int main() {
    int arr[100], n, target;
    bool found = false;

    cout << "Enter the number of elements: ";
    cin >> n;

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Enter the target sum: ";
    cin >> target;

    // Find pairs with the given sum
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] + arr[j] == target) {
                cout << "Pair found: " << arr[i]
                     << " and " << arr[j] << endl;
                found = true;
            }
        }
    }

    if (!found) {
        cout << "No pair found";
    }

    return 0;
}